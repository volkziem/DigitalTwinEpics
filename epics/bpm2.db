# ./dtwinApp/Db/bpm2.db

record(waveform, "$(USER):IPM:XPOS") {
  field(DESC,"All BPM horizontal")
  field(DTYP,"stream")
  field(SCAN,"10 second")
  field(NELM,"10")
  field(FTVL,"FLOAT")
  field(INP,"@misc.proto get_bpmx $(PORT)")
}

record(waveform, "$(USER):IPM:YPOS") {
  field(DESC,"All BPM vertical")
  field(DTYP,"stream")
  field(SCAN,"10 second")
  field(NELM,"10")
  field(FTVL,"FLOAT")
  field(INP,"@misc.proto get_bpmy $(PORT)")
}
