# ./dtwinApp/Db/misc.db

record(ao, "$(USER):quit") {
  field(DESC, "turn digital twin off")
  field(DTYP, "stream")
  field(OUT, "@misc.proto send_quit $(PORT)")
}

record(ao, "$(USER):MISALIGN") {
  field(DESC, "Misalign magnets off")
  field(DTYP, "stream")
  field(OUT, "@misc.proto send_misalign $(PORT)")
}

record(ao, "$(USER):RESET") {
  field(DESC, "Reload beamline")
  field(DTYP, "stream")
  field(OUT, "@misc.proto reset $(PORT)")
}

record(ao, "$(USER):SHOW_SCREENS") {
  field(DESC, "Display Viewers")
  field(DTYP, "stream")
  field(OUT, "@misc.proto show_screens $(PORT)")
}

record(stringout, "$(USER):SCREEN") {
  field(DESC,"Select screen")
  field(DTYP,"stream")
  field(OUT,"@misc.proto set_screen $(PORT)")
}

record(waveform, "$(USER):SIGMAS") {
  field(DESC,"beam sigmas")
  field(DTYP,"stream")
  field(NELM,"3")
  field(FTVL,"FLOAT")
  field(SCAN,"I/O Intr")
  field(INP,"@misc.proto get_sigmas $(PORT)")
}

record(stringout, "$(USER):TM:FROM") {
  field(DESC,"Select TM range")
  field(DTYP,"stream")
  field(OUT,"@misc.proto set_tm_from $(PORT)")
}

record(stringout, "$(USER):TM:TO") {
  field(DESC,"Select TM range")
  field(DTYP,"stream")
  field(OUT,"@misc.proto set_tm_to $(PORT)")
}

record(waveform, "$(USER):TM") {
  field(DESC,"transfer matrix")
  field(DTYP,"stream")
  field(NELM,"16")
  field(FTVL,"FLOAT")
  field(SCAN,"I/O Intr")
  field(INP,"@misc.proto get_tm $(PORT)")
}

record(waveform, "$(USER):ALLBPM") {
  field(DESC,"all bpms")
  field(DTYP,"stream")
  field(NELM,"20")
  field(FTVL,"FLOAT")
  field(SCAN,"I/O Intr")
  field(INP,"@misc.proto get_allbpm $(PORT)")
}

record(ao, "$(USER):MFX2I01:BDL") {
  field(DESC, "magnet MFX2I01:BDL value")
  field(DTYP, "stream")
  field(OUT, "@misc.proto set_MFX2I01 $(PORT)")
}

record(ao, "$(USER):MFX1I03:BDL") {
  field(DESC, "magnet MFX1I03:BDL value")
  field(DTYP, "stream")
  field(OUT, "@misc.proto set_MFX1I03 $(PORT)")
}

record(ao, "$(USER):MFG1I04:BDL") {
  field(DESC, "magnet MFG1I04:BDL value")
  field(DTYP, "stream")
  field(OUT, "@misc.proto set_MFG1I04 $(PORT)")
}

record(ao, "$(USER):MFX0I01:BDL") {
  field(DESC, "magnet MFX0I01:BDL value")
  field(DTYP, "stream")
  field(OUT, "@misc.proto set_MFX0I01 $(PORT)")
}
