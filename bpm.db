# ./dtwinApp/Db/bpm.db

record(ai, "$(USER):IPM2I00:XPOS") {
  field(DESC, "IPM2I00 horizontal")
  field(SCAN, "2 second")
  field(DTYP, "stream")
  field(INP, "@bpm.proto get_IPM2I00X $(PORT)")
}

